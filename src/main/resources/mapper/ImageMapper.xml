<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.staitech.file.mapper.ImageMapper">
    <update id="updateByPrimaryKeyToProcessFlag"
            parameterType="cn.staitech.file.domain.Image">
        update fm_image
        set process_flag = #{processFlag,jdbcType=SMALLINT}
        where image_id = #{imageId,jdbcType=BIGINT}
    </update>
</mapper>
