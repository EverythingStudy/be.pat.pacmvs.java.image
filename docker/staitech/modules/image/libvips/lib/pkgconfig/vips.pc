prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: vips
Description: Image processing library
Version: 8.7.1
Requires.private:  glib-2.0 gmodule-2.0 gobject-2.0 libgsf-1 fftw3 MagickCore orc-0.4 OpenEXR zlib openslide libtiff-4 libpng libjpeg
Requires: gobject-2.0
Libs: -L${libdir} -lvips 
Libs.private: 
Cflags: -I${includedir}

